name: Build APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Buat proyek Kantor AI
        run: |
          mkdir -p app/src/main/assets app/src/main/java/com/kantorai/app
          cat > app/src/main/assets/index.html <<'EOF_FILE_0'
          <!doctype html>
          <html lang="id">
          <head>
          <meta charset="utf-8">
          <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
          <title>Kantor AI</title>
          <style>
          *{box-sizing:border-box}
          html,body{margin:0;background:#0c0e26;color:#fff;font-family:system-ui,-apple-system,sans-serif}
          body{padding:14px;max-width:560px;margin:0 auto}
          h1{font-size:26px;margin:6px 0 2px;text-align:center}
          p.sub{margin:0 0 12px;text-align:center;color:#a9b4e0;font-size:14px}
          .stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
          .stat{background:#1a1e44;border-radius:10px;padding:10px 12px}
          .stat span{display:block;font-size:12px;color:#a9b4e0}
          .stat b{font-size:24px;font-weight:600}
          .row{display:flex;gap:8px;margin-bottom:10px}
          select,button{font-size:16px;border-radius:10px;border:0;padding:12px;color:#fff;background:#262b5c}
          select{flex:1;min-width:0}
          button{background:#3b6ef5;font-weight:600}
          canvas{width:100%;height:auto;display:block;border-radius:14px}
          .chips{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
          .chip{background:#1a1e44;border-radius:10px;padding:8px 10px;font-size:13px;display:flex;align-items:center;gap:8px}
          .chip i{width:10px;height:10px;border-radius:50%;display:inline-block;flex:none}
          .chip small{display:block;color:#a9b4e0;font-size:12px}
          .log{margin-top:10px;background:#1a1e44;border-radius:10px;padding:12px;font-size:14px;line-height:1.6;min-height:60px}
          </style>
          </head>
          <body>
          <h1>Kantor AI</h1>
          <p class="sub">Karyawannya 100% AI</p>
          <div class="stats">
            <div class="stat"><span>Tugas selesai</span><b id="done">0</b></div>
            <div class="stat"><span>Agen bekerja</span><b id="active">0 / 4</b></div>
          </div>
          <div class="row">
            <select id="task">
              <option value="sales">Laporan penjualan</option>
              <option value="comp">Riset kompetitor</option>
              <option value="mail">Balas email pelanggan</option>
            </select>
            <button id="run">Beri tugas</button>
          </div>
          <canvas id="cv" width="540" height="470"></canvas>
          <div class="chips" id="chips"></div>
          <div class="log" id="log">Pilih tugas lalu tekan Beri tugas.</div>
          <script>
          const W=540,H=470,CX=270,CY=255;
          const cv=document.getElementById('cv'),g=cv.getContext('2d');
          const hex=h=>[parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];
          const rgb=c=>'rgb('+c[0]+','+c[1]+','+c[2]+')';
          const rad=d=>d*Math.PI/180;
          const AG=[
           {n:'Agen riset',px:-2.8,py:-2.8,sh:hex('#1D9E75'),sk:hex('#f1c9a5'),hr:hex('#2c2c2a')},
           {n:'Agen analis',px:2.8,py:-2.8,sh:hex('#7F77DD'),sk:hex('#d9a37a'),hr:hex('#4a1b0c')},
           {n:'Agen penulis',px:-2.8,py:2.8,sh:hex('#D85A30'),sk:hex('#f1c9a5'),hr:hex('#d9a441')},
           {n:'Agen admin',px:2.8,py:2.8,sh:hex('#BA7517'),sk:hex('#b97f56'),hr:hex('#2c2c2a')}
          ];
          AG.forEach(a=>{a.st='idle';a.pr=0;a.step=''});
          const TASKS={
           sales:['Ambil data','Hitung tren','Tulis laporan','Kirim email'],
           comp:['Cari kompetitor','Banding harga','Tulis SWOT','Simpan file'],
           mail:['Baca email','Kelompokkan','Tulis balasan','Kirim balasan']
          };
          const chips=document.getElementById('chips');
          AG.forEach((a,k)=>{chips.insertAdjacentHTML('beforeend','<div class="chip"><i style="background:'+rgb(a.sh)+'"></i><div>'+a.n+'<small id="c'+k+'">siaga</small></div></div>')});
          const LN=Math.hypot(.4,.5,.77),LT=[-.4/LN,-.5/LN,.77/LN];
          function shade(c,n){const d=Math.max(0,n[0]*LT[0]+n[1]*LT[1]+n[2]*LT[2]),f=.45+.55*d;return c.map(v=>Math.min(255,Math.floor(v*f)))}
          function faces(b){
           const [x,y,z,w,d,h]=b,x0=x,x1=x+w,y0=y,y1=y+d,z0=z,z1=z+h;
           return [
            [[0,0,1],[[x0,y0,z1],[x1,y0,z1],[x1,y1,z1],[x0,y1,z1]]],
            [[1,0,0],[[x1,y0,z0],[x1,y1,z0],[x1,y1,z1],[x1,y0,z1]]],
            [[-1,0,0],[[x0,y0,z0],[x0,y1,z0],[x0,y1,z1],[x0,y0,z1]]],
            [[0,1,0],[[x0,y1,z0],[x1,y1,z0],[x1,y1,z1],[x0,y1,z1]]],
            [[0,-1,0],[[x0,y0,z0],[x1,y0,z0],[x1,y0,z1],[x0,y0,z1]]]
           ];
          }
          function proj(p,c){
           const x=p[0],y=p[1],z=p[2],x1=x*c.ca-y*c.sa,y1=x*c.sa+y*c.ca;
           return [CX+c.sc*x1,CY-c.sc*(z*c.ce+y1*c.se),y1*c.ce-z*c.se];
          }
          let flight=null,running=false,doneCount=0;
          function draw(t,now){
           const c={az:rad(40+25*Math.sin(t*.3)),el:rad(40+3*Math.sin(t*.8)),sc:36+1.5*Math.sin(t*.7)};
           c.ca=Math.cos(c.az);c.sa=Math.sin(c.az);c.ce=Math.cos(c.el);c.se=Math.sin(c.el);
           const gr=g.createLinearGradient(0,0,0,H);gr.addColorStop(0,'#0c0e26');gr.addColorStop(1,'#2e164e');
           g.fillStyle=gr;g.fillRect(0,0,W,H);
           const poly=(pts,fill,stroke,glow)=>{
            g.beginPath();
            pts.forEach((p,i)=>{const q=proj(p,c);if(i)g.lineTo(q[0],q[1]);else g.moveTo(q[0],q[1])});
            g.closePath();g.fillStyle=fill;
            if(glow){g.shadowColor=fill;g.shadowBlur=14}
            g.fill();g.shadowBlur=0;
            if(stroke){g.strokeStyle=stroke;g.lineWidth=1;g.stroke()}
           };
           const box=(b,col,em)=>{
            for(const f of faces(b)){
             const n=f[0],nry=n[0]*c.sa+n[1]*c.ca;
             if(nry*c.ce-n[2]*c.se>=0)continue;
             if(em)poly(f[1],rgb(col),null,true);
             else{const s=shade(col,n);poly(f[1],rgb(s),rgb(s.map(v=>Math.floor(v*.6))))}
            }
           };
           box([-5.1,-5.1,-.5,10.2,10.2,.08],[80,120,255],true);
           box([-5,-5,-.42,10,10,.42],[30,32,60]);
           for(let i=0;i<10;i++)for(let j=0;j<10;j++){
            const col=(i+j)%2?[46,50,88]:[38,42,76],x0=-5+i,y0=-5+j;
            poly([[x0,y0,0],[x0+1,y0,0],[x0+1,y0+1,0],[x0,y0+1,0]],rgb(col));
           }
           for(let k=0;k<3;k++){
            const A=AG[k],B=AG[k+1],dx=B.px-A.px,dy=B.py-A.py,L=Math.hypot(dx,dy),nx=-dy/L*.07,ny=dx/L*.07;
            const on=flight&&flight.a===k;
            poly([[A.px+nx,A.py+ny,.01],[B.px+nx,B.py+ny,.01],[B.px-nx,B.py-ny,.01],[A.px-nx,A.py-ny,.01]],on?'rgb(90,240,255)':'rgb(50,70,140)',null,!!on);
           }
           const items=[];
           const add=(b,col,em)=>{items.push({d:proj([b[0]+b[3]/2,b[1]+b[4]/2,b[2]+b[5]/2],c)[2],b:b,col:col,em:!!em})};
           const working=AG.some(a=>a.st==='work'),pulse=.5+.5*Math.sin(t*5);
           const cc=working?[Math.floor(60+80*pulse),Math.floor(200+50*pulse),255]:[80,140,200];
           add([-.9,-.9,0,1.8,1.8,.4],[40,44,70]);
           add([-.5,-.5,.4+.1*Math.sin(t*3),1,1,1],cc,true);
           [[-4.6,-4.6],[4.1,-4.6],[-4.6,4.1],[4.1,4.1]].forEach(p=>{
            add([p[0],p[1],0,.5,.5,.45],[153,60,29]);
            add([p[0]+.1,p[1]+.1,.45,.3,.3,.5],[59,109,17]);
            add([p[0]-.02,p[1]-.02,.75,.54,.54,.3],[99,153,34]);
           });
           AG.forEach((a,k)=>{
            const px=a.px,py=a.py,s=py<0?-1:1,st=a.st;
            add([px-1.2,py-.55,0,2.4,1.1,.9],[139,94,60]);
            add([px-.7,py+s*.3-.15,.9,1,.3,.05],[210,210,200]);
            add([px+.4,py-.1,.9,.2,.2,.1],[95,94,90]);
            add([px-.1,py-.08,.95,1.2,.16,.75],[35,35,40]);
            let sc;
            if(st==='work')sc=[60,Math.floor(200+40*Math.sin(t*12+k)),170];
            else if(st==='wave'||st==='done')sc=[50,170,110];
            else sc=[60,70,95];
            add([px-.02,s<0?py-.11:py+.07,1.03,1.04,.04,.6],sc,true);
            const ay=py+s*1.2,bob=st==='idle'?.03*Math.sin(t*3+k):0;
            add([px-.55,ay-.4,0,1.1,.8,.5],[80,80,86]);
            add([px-.55,ay+s*.45-.05,.5,1.1,.1,1],[80,80,86]);
            add([px-.4,ay-.25,.5+bob,.8,.5,.9],a.sh);
            add([px-.3,ay-.28,1.4+bob,.6,.56,.55],a.sk);
            add([px-.3,ay-.28,1.85+bob,.6,.56,.15],a.hr);
            add([px-.04,ay-.04,2+bob,.08,.08,.35],[136,135,128]);
            const lit=(st==='work'&&Math.floor(t*4)%2===0)||st==='wave';
            add([px-.12,ay-.12,2.35+bob,.24,.24,.24],lit?[250,199,117]:[180,178,169],lit);
            if(st==='work'){
             const hy=py+s*.3-.1;
             add([px-.5+.5*(.5+.5*Math.sin(t*25)),hy,.95,.2,.2,.12],a.sk);
             add([px+.2+.4*(.5+.5*Math.sin(t*25+3)),hy,.95,.2,.2,.12],a.sk);
            }else if(st==='wave'){
             add([px+.5,ay-.1,1+.3*Math.abs(Math.sin(t*8)),.2,.2,.8],a.sk);
            }
           });
           if(flight){
            const p=Math.min(1,(now-flight.t0)/800),A=AG[flight.a],B=AG[flight.b];
            const x=A.px+(B.px-A.px)*p,y=A.py+(B.py-A.py)*p,z=1.6+1.2*Math.sin(Math.PI*p);
            add([x-.25,y-.18,z,.5,.36,.06],[255,255,255]);
           }
           items.sort((p,q)=>q.d-p.d);
           items.forEach(it=>box(it.b,it.col,it.em));
          }
          function loop(now){draw(now/1000,now);requestAnimationFrame(loop)}
          requestAnimationFrame(loop);
          const sleep=ms=>new Promise(r=>setTimeout(r,ms));
          const logEl=document.getElementById('log');
          function chip(k,txt){document.getElementById('c'+k).textContent=txt}
          document.getElementById('run').onclick=async()=>{
           if(running)return;running=true;
           const steps=TASKS[document.getElementById('task').value];
           logEl.textContent='';
           AG.forEach((a,k)=>chip(k,'siaga'));
           for(let k=0;k<4;k++){
            const a=AG[k];a.st='work';a.step=steps[k];
            document.getElementById('active').textContent='1 / 4';
            logEl.insertAdjacentHTML('beforeend','<div>'+a.n+': '+steps[k]+'</div>');
            for(let p=0;p<=100;p+=4){a.pr=p;chip(k,steps[k]+' '+p+'%');await sleep(45)}
            a.st='wave';chip(k,'selesai');
            document.getElementById('active').textContent='0 / 4';
            if(k<3){flight={a:k,b:k+1,t0:performance.now()};await sleep(800);flight=null}
            else await sleep(1500);
            a.st='done';
           }
           AG.forEach(a=>a.st='idle');
           doneCount++;document.getElementById('done').textContent=doneCount;
           logEl.insertAdjacentHTML('beforeend','<div><b>Tugas selesai tanpa campur tangan manusia.</b></div>');
           running=false;
          };
          </script>
          </body>
          </html>
          EOF_FILE_0
          cat > app/src/main/AndroidManifest.xml <<'EOF_FILE_1'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <application
                  android:label="Kantor AI"
                  android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
                  <activity
                      android:name=".MainActivity"
                      android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>
              </application>
          </manifest>
          EOF_FILE_1
          cat > app/src/main/java/com/kantorai/app/MainActivity.java <<'EOF_FILE_2'
          package com.kantorai.app;

          import android.app.Activity;
          import android.graphics.Color;
          import android.os.Bundle;
          import android.webkit.WebSettings;
          import android.webkit.WebView;

          public class MainActivity extends Activity {
              private WebView web;

              @Override
              protected void onCreate(Bundle savedInstanceState) {
                  super.onCreate(savedInstanceState);
                  web = new WebView(this);
                  web.setBackgroundColor(Color.parseColor("#0e1026"));
                  WebSettings s = web.getSettings();
                  s.setJavaScriptEnabled(true);
                  setContentView(web);
                  web.loadUrl("file:///android_asset/index.html");
              }

              @Override
              public void onBackPressed() {
                  if (web.canGoBack()) {
                      web.goBack();
                  } else {
                      super.onBackPressed();
                  }
              }
          }
          EOF_FILE_2
          cat > app/build.gradle <<'EOF_FILE_3'
          plugins {
              id 'com.android.application'
          }

          android {
              namespace 'com.kantorai.app'
              compileSdk 34

              defaultConfig {
                  applicationId 'com.kantorai.app'
                  minSdk 24
                  targetSdk 34
                  versionCode 1
                  versionName '1.0'
              }

              buildTypes {
                  release {
                      minifyEnabled false
                  }
              }

              compileOptions {
                  sourceCompatibility JavaVersion.VERSION_17
                  targetCompatibility JavaVersion.VERSION_17
              }
          }
          EOF_FILE_3
          cat > build.gradle <<'EOF_FILE_4'
          plugins {
              id 'com.android.application' version '8.5.2' apply false
          }
          EOF_FILE_4
          cat > settings.gradle <<'EOF_FILE_5'
          pluginManagement {
              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }
          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories {
                  google()
                  mavenCentral()
              }
          }
          rootProject.name = 'KantorAI'
          include ':app'
          EOF_FILE_5
          cat > gradle.properties <<'EOF_FILE_6'
          org.gradle.jvmargs=-Xmx2g
          android.nonTransitiveRClass=true
          EOF_FILE_6
      - name: Build APK
        run: gradle assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: kantor-ai-apk
          path: app/build/outputs/apk/debug/app-debug.apk
